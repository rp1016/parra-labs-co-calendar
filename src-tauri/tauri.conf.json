{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CalendarPRO",
  "version": "0.2.1",
  "identifier": "com.parritalabs.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CalendarPRO — by Parrita Labs",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ParritaLabs",
    "homepage": "https://parritalabs.com",
    "copyright": "© 2026 ParritaLabs",
    "category": "Productivity",
    "shortDescription": "Calendario, agenda y notas 100% locales",
    "longDescription": "CalendarPRO de Parrita Labs reúne calendario, agenda y notas en una app que guarda todo en tu equipo. Sin cuentas, sin nube y sin telemetría. Incluye seis temas, exportación .ics y respaldos completos en JSON o Markdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish", "English"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": { "section": "utils" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
